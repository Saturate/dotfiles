# Shared Git Configuration

[user]
    name = Allan Kimmer Jensen
    email = hi@akj.io
    signingkey = ssh-rsa 

# 1Password SSH signing
[gpg]
    format = ssh

# 1Password sets these automatically per OS — shown here for reference:
# [gpg "ssh"]
#     program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign  # macOS
#     program = /opt/1Password/op-ssh-sign                              # Linux
#     program = C:/Users/YOU/AppData/Local/1Password/app/8/op-ssh-sign.exe  # Windows

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    sw = switch
    unstage = reset HEAD --
    last = log -1 HEAD
    lg = log --oneline --graph --decorate --all
