# https://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{js,ts,jsx,tsx,css,scss,html,vue,svelte}]
indent_style = tab

# JSON/YAML — spaces (parsers can be picky)
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.rs]
indent_style = space
indent_size = 4

[*.{md,mdx}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[Dockerfile*]
indent_style = space
indent_size = 2
